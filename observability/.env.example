# Copy to observability/.env and adjust. Compose reads .env automatically.
#
# The address the containers use to reach services running on WINDOWS
# (windows_exporter :9182, nvidia_gpu_exporter :9835, wes_server :8080).
#
# Docker runs inside WSL here, so this is the WSL VM's default gateway — a NAT
# address that is regenerated when WSL restarts. Find the current one with:
#
#   wsl -e bash -lc 'ip route show default'
#
# On Docker Desktop use host.docker.internal, which does not move.
WES_WINDOWS_HOST=172.22.64.1

# Grafana login. Defaults to admin/admin if unset, as on the old Pi install.
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin
